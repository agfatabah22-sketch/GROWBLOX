    function adapter.PickupView()
        local a=app.Anchor
        local enabled=app.Alive and app.Engine and app.Engine.State.running or false
        if anchorIssue() or paused() then return {enabled=enabled,ready=false} end
        refreshBlockProvenance(os.clock())
