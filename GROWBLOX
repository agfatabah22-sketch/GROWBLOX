        red = Color3.fromRGB(158, 59, 75), border = Color3.fromRGB(57, 83, 115),
    }
    local function number(value)
        value = tonumber(value)
        return value and value == value and value >= 0 and value < math.huge and math.floor(value) or 0
    end
    local function create(class, properties, owner)
        local item = Instance.new(class)
        for key, value in pairs(properties) do item[key] = value end
        item.Parent = owner
        return item
    end
    local function corner(owner, radius)
        create("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, owner)
    end
    local function connect(signal, fn)
        local connection = signal:Connect(fn)
        connections[#connections + 1] = connection
        return connection
    end
    local function label(owner, value, x, y, width, height, size, color, bold)
        return create("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(x, y),
            Size = UDim2.fromOffset(width, height), Text = value,
            Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
            TextSize = size or 12, TextColor3 = color or colors.text,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true,
        }, owner)
    end
    local function button(owner, value, x, y, width, height, background)
        local item = create("TextButton", {
            Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height),
            BackgroundColor3 = background or colors.card, BorderSizePixel = 0,
            Text = value, Font = Enum.Font.GothamBold, TextSize = 12,
            TextColor3 = colors.text, AutoButtonColor = true, Active = true,
        }, owner)
        corner(item)
        return item
    end
    local gui = create("ScreenGui", {
        Name = "BlueHubGrowbloxGrassFarm", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 9981, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, parent)
    local panel = create("Frame", {
        Name = "Panel", BackgroundColor3 = colors.panel, BorderSizePixel = 0,
        Size = UDim2.fromOffset(panelWidth, panelHeight), Active = true,
    }, gui)
    corner(panel, 12)
    create("UIStroke", { Color = colors.border, Thickness = 1 }, panel)
    local scale = create("UIScale", { Scale = 1 }, panel)
    local header = create("Frame", {
        Name = "Header", BackgroundTransparency = 1, Active = true,
        Size = UDim2.fromOffset(panelWidth, 52),
    }, panel)
    label(header, "BLUE HUB · BLOCK FARM", 16, 14, 320, 24, 16, colors.text, true)
    local minimize = button(header, "−", 368, 14, 26, 28)
    minimize.Name = "Minimize"
    local close = button(header, "×", 400, 14, 26, 28)
    close.Name = "Close"
    local anchor = label(panel, "Titik belum disimpan · tekan SET TITIK.", 16, 54, 408, 24, 12, colors.muted)
    anchor.Name = "Anchor"
    local cropSelector = button(panel, "  Grass ↔ Grass Seed   ▾", 16, 83, 408, 34)
    cropSelector.Name = "CropSelector"
    cropSelector.TextXAlignment = Enum.TextXAlignment.Left
    cropSelector.TextTruncate = Enum.TextTruncate.AtEnd
    local modeFarm = button(panel, "FARM + TANAM", 16, 128, 200, 26, colors.blue)
    modeFarm.Name, modeFarm.TextSize = "ModeFarm", 11
    local modeBreak = button(panel, "BREAK ONLY", 224, 128, 200, 26, colors.card)
    modeBreak.Name, modeBreak.TextSize = "ModeBreakOnly", 11
    local countRow = create("Frame", {
        Name = "PlantCountSettings", BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 162), Size = UDim2.fromOffset(408, 30),
    }, panel)
    label(countRow, "TOTAL TANAMAN (1–99)", 0, 0, 174, 30, 10, colors.muted, true)
    local countInput = create("TextBox", {
        Name = "PlantCountInput", Position = UDim2.fromOffset(176, 0), Size = UDim2.fromOffset(80, 30),
        BackgroundColor3 = colors.card, BorderSizePixel = 0, Text = tostring(plantCount), PlaceholderText = "1–99",
        PlaceholderColor3 = colors.muted, TextColor3 = colors.text, Font = Enum.Font.GothamBold,
        TextSize = 13, ClearTextOnFocus = false, Active = true, TextEditable = true,
    }, countRow)
    corner(countInput)
    local applyCount = button(countRow, "TERAPKAN", 270, 0, 138, 30, colors.blue)
    applyCount.Name, applyCount.TextSize = "ApplyPlantCount", 11
    local diagram = create("Frame", {
        Name = "FarmDiagram", BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 202), Size = UDim2.fromOffset(408, 78),
    }, panel)
    label(diagram, "ATAS", 0, 0, 62, 30, 10, colors.muted, true)
    local treeCaption = label(diagram, "TANAM", 0, 35, 62, 22, 10, colors.muted, true)
    local seedVisuals = {}
    local breakCaption = label(diagram, "Tanpa tanam / panen seed", 72, 35, 312, 38, 11, colors.muted)
    breakCaption.Visible = false
    for index = 1, 3 do
        local x = 136 + (index - 1) * 64
        local block = create("Frame", {
            Name = "Block_" .. index, Position = UDim2.fromOffset(x, 0),
            Size = UDim2.fromOffset(56, 30), BackgroundColor3 = Color3.fromRGB(38, 89, 67), BorderSizePixel = 0,
        }, diagram)
        corner(block, 6)
        local blockLabel = label(block, "BLOCK " .. index, 2, 0, 52, 30, 9, colors.green, true)
        blockLabel.TextXAlignment = Enum.TextXAlignment.Center
    end
    for index = 1, 21 do
        local x = 72 + (index - 1) * 15
        local seed = create("Frame", {
            Name = "Seed_" .. index, Position = UDim2.fromOffset(x, 39),
            Size = UDim2.fromOffset(11, 18),
            BackgroundColor3 = index == 11 and colors.blue or Color3.fromRGB(38, 89, 67), BorderSizePixel = 0,
        }, diagram)
        corner(seed, 3)
        seedVisuals[#seedVisuals + 1] = seed
    end
    local patternCaption = label(diagram, "", 72, 61, 312, 17, 9, colors.muted, true)
    patternCaption.Name, patternCaption.TextXAlignment = "PlantLayoutCaption", Enum.TextXAlignment.Center
    local function renderPlants()
        local shown = math.min(plantCount, #seedVisuals)
        local shownLeft = math.floor((shown - 1) / 2)
        for index, seed in ipairs(seedVisuals) do
            seed.Visible = farmMode == "farm" and index <= shown
            seed.Position = UDim2.fromOffset(222 + (index - shownLeft - 1) * 15, 39)
            seed.BackgroundColor3 = index == shownLeft + 1 and colors.blue or Color3.fromRGB(38, 89, 67)
        end
        local left = math.floor((plantCount - 1) / 2)
        local right = plantCount - left - 1
        patternCaption.Text = plantCount == 1 and "1 tanaman di titik berdiri"
            or (left .. " kiri · 1 titik · " .. right .. " kanan" .. (plantCount > shown and " · diagram ringkas" or ""))
        patternCaption.Visible = farmMode == "farm"
    end
    local flowLabel = label(panel, "Tanam tuntas → farm 3 blok hingga semua matang → panen tuntas.", 16, 284, 408, 20, 11, colors.text)
    local helpLabel = label(panel, "Ambil khusus hasil break block bot.\nDrop pohon dibiarkan; terambil saat karakter lewat.", 16, 305, 408, 28, 10, colors.muted)
    local progress = label(panel, "Terisi 0/" .. plantCount .. " · Tumbuh: 0 · Matang: 0", 16, 333, 408, 22, 12, colors.muted, true)
    progress.Name = "PlantProgress"
    local inventoryLabels, inventoryTitles = {}, {}
    for index, item in ipairs({ { "seeds", "GRASS SEED" }, { "blocks", "GRASS BLOCK" } }) do
        local card = create("Frame", {
            Position = UDim2.fromOffset(16 + (index - 1) * 208, 366),
            Size = UDim2.fromOffset(200, 49), BackgroundColor3 = colors.card, BorderSizePixel = 0,
        }, panel)
        corner(card)
        inventoryTitles[item[1]] = label(card, item[2], 10, 5, 180, 14, 9, colors.muted, true)
        inventoryTitles[item[1]].TextWrapped = false
        inventoryTitles[item[1]].TextTruncate = Enum.TextTruncate.AtEnd
        inventoryLabels[item[1]] = label(card, "0", 10, 21, 180, 23, 20, colors.green, true)
        inventoryLabels[item[1]].Name = item[1]
    end
    local totals = label(panel, "Tanam: 0  ·  Pasang: 0  ·  Pukul: 0  ·  Panen: 0", 16, 422, 408, 21, 11, colors.muted)
    totals.Name = "Totals"
    local statusBox = create("Frame", {
        Position = UDim2.fromOffset(16, 451), Size = UDim2.fromOffset(408, 60),
        BackgroundColor3 = colors.card, BorderSizePixel = 0,
    }, panel)
    corner(statusBox)
    local status = label(statusBox, "Siap. Simpan titik berdiri, lalu tekan START.", 10, 7, 388, 46, 12, colors.text)
    status.Name = "Status"
    status.TextYAlignment = Enum.TextYAlignment.Top
    local start = button(panel, "START", 16, 519, 128, 34, colors.card)
    start.Name = "Start"
    local stop = button(panel, "STOP", 152, 519, 128, 34, colors.red)
    stop.Name = "Stop"
    local capture = button(panel, "SET TITIK", 288, 519, 136, 34)
    capture.Name = "Capture"
    label(panel, "F8: stop  ·  Right Shift: hide  ·  Drag judul", 16, 561, 408, 17, 10, colors.muted)
    local picker = create("Frame", {
        Name = "CropPicker", BackgroundColor3 = colors.panel, BorderSizePixel = 0,
        Size = UDim2.fromOffset(panelWidth, panelHeight), Active = true, Visible = false,
    }, gui)
    corner(picker, 12)
    create("UIStroke", { Color = colors.border, Thickness = 1 }, picker)
    local pickerScale = create("UIScale", { Scale = 1 }, picker)
    local pickerHeader = create("Frame", {
        Name = "Header", BackgroundTransparency = 1, Active = true,
        Size = UDim2.fromOffset(panelWidth, 64),
    }, picker)
    label(pickerHeader, "PILIH SEED ↔ BLOCK", 16, 13, 310, 24, 15, colors.text, true)
    label(pickerHeader, "Cari nama; pasangan block dipilih otomatis.", 16, 39, 408, 20, 11, colors.muted)
    local pickerBack = button(pickerHeader, "KEMBALI", 344, 13, 80, 28)
    pickerBack.Name = "Back"
    local search = create("TextBox", {
        Name = "Search", Position = UDim2.fromOffset(16, 72), Size = UDim2.fromOffset(408, 34),
        BackgroundColor3 = colors.card, BorderSizePixel = 0, Text = "", PlaceholderText = "Cari Grass, Dirt, nama seed atau block...",
        PlaceholderColor3 = colors.muted, TextColor3 = colors.text, Font = Enum.Font.Gotham,
        TextSize = 13, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
        Active = true,
    }, picker)
    corner(search)
    create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, search)
    local matchCount = label(picker, "0 cocok", 16, 112, 408, 20, 11, colors.muted)
    matchCount.Name = "MatchCount"
    local results = create("ScrollingFrame", {
        Name = "Results", Position = UDim2.fromOffset(16, 140), Size = UDim2.fromOffset(408, 375),
        BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.fromOffset(0, 0),
        ScrollBarThickness = 4, ScrollBarImageColor3 = colors.border, Active = true, ClipsDescendants = true,
    }, picker)
    -- Pool the result controls once. Inventory refreshes never replace the TextBox
    -- or rebuild hundreds of buttons while the user is selecting a crop.
    for index = 1, 40 do
        local row = button(results, "", 0, (index - 1) * 50, 400, 45)
        row.Name, row.Visible = "Crop_" .. index, false
        local name = label(row, "", 10, 4, 378, 20, 12, colors.text, true)
        name.TextWrapped, name.TextTruncate = false, Enum.TextTruncate.AtEnd
        local detail = label(row, "", 10, 25, 378, 15, 10, colors.muted)
        detail.TextWrapped, detail.TextTruncate = false, Enum.TextTruncate.AtEnd
        pickerRows[index] = { button = row, name = name, detail = detail }
    end
    local emptyMessage = label(picker, "Belum ada hasil. Coba nama lain atau REFRESH.", 28, 155, 384, 46, 12, colors.muted)
    emptyMessage.Name, emptyMessage.Visible = "EmptyResults", false
    local pickerStatus = label(picker, "Ubah pilihan saat farm berhenti.", 16, 523, 260, 44, 11, colors.muted)
    pickerStatus.Name = "Status"
    pickerStatus.TextYAlignment = Enum.TextYAlignment.Top
    local refreshCrops = button(picker, "REFRESH TAS", 286, 527, 138, 30)
    refreshCrops.Name = "Refresh"
    local launcher = button(gui, "BH", 12, 120, 44, 44, colors.blue)
    launcher.Name, launcher.Visible = "Launcher", false
    local api = {}
    local function layout()
        if destroyed then return end
        local camera = Workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
        local factor = math.clamp(math.min((viewport.X - 20) / panelWidth, (viewport.Y - 20) / panelHeight), 0.35, 1)
        scale.Scale = factor
        pickerScale.Scale = factor
        local width, height = panelWidth * factor, panelHeight * factor
        position = position or Vector2.new(viewport.X - width - 18, math.max(12, (viewport.Y - height) / 2))
        position = Vector2.new(math.clamp(position.X, 8, math.max(8, viewport.X - width - 8)),
            math.clamp(position.Y, 8, math.max(8, viewport.Y - height - 8)))
        -- Use viewport positions directly; this game's reported absolute origin has an inset.
        panel.Position = UDim2.fromOffset(position.X, position.Y)
        picker.Position = panel.Position
        launcher.Position = UDim2.fromOffset(12, math.clamp(math.max(120, position.Y), 8, math.max(8, viewport.Y - 52)))
    end
    local function bindCamera()
        if cameraConnection then cameraConnection:Disconnect() cameraConnection = nil end
        if Workspace.CurrentCamera then cameraConnection = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
        layout()
    end
    function api.SetVisible(value)
        if destroyed then return end
        hidden = value ~= true
        panel.Visible, picker.Visible, launcher.Visible = not hidden and not pickerOpen, not hidden and pickerOpen, hidden
        if hidden then search:ReleaseFocus() countInput:ReleaseFocus() end
        dragging = nil
        layout()
    end
    function api.SetStatus(value)
        if not destroyed then
            status.Text = tostring(value or "")
            pickerStatus.Text = status.Text
        end
    end
    local function setPickerOpen(value)
        if destroyed then return end
        pickerOpen = value == true
        if pickerOpen then countInput:ReleaseFocus() end
        if not pickerOpen then search:ReleaseFocus() end
        panel.Visible, picker.Visible = not hidden and not pickerOpen, not hidden and pickerOpen
        dragging = nil
        layout()
    end
    local function growText(value)
        local seconds = number(value)
        if seconds == 0 then return "?" end
        if seconds >= 3600 then return math.floor(seconds / 3600) .. "j " .. math.floor(seconds % 3600 / 60) .. "m" end
        if seconds >= 60 then return math.floor(seconds / 60) .. "m " .. seconds % 60 .. "d" end
        return seconds .. " dtk"
    end
    local function renderResults(resetScroll)
        if destroyed then return end
        local query = tostring(search.Text or ""):lower():match("^%s*(.-)%s*$")
        local shown, matched = {}, 0
        for _, crop in ipairs(catalog) do
            if query == "" or crop.searchKey:find(query, 1, true) then
                matched = matched + 1
                if #shown < 40 then shown[#shown + 1] = crop end
            end
        end
        matchCount.Text = matched .. " cocok · " .. #shown .. " ditampilkan" .. (matched > 40 and " · persempit pencarian" or "")
        emptyMessage.Visible = matched == 0
        for index, row in ipairs(pickerRows) do
            local crop = shown[index]
            row.crop, row.button.Visible = crop, crop ~= nil
            if crop then
                local selected = crop.seedId == selectedSeedId
                row.button.BackgroundColor3 = selected and Color3.fromRGB(27, 75, 101) or colors.card
                row.name.Text = (selected and "✓ " or "") .. crop.blockName .. " ↔ " .. crop.seedName
                row.name.TextColor3 = selected and colors.green or colors.text
                row.detail.Text = "Seed: " .. crop.seeds .. " · Block: " .. crop.blocks .. " · Tumbuh: " .. growText(crop.grow)
            end
        end
        results.CanvasSize = UDim2.fromOffset(0, #shown * 50)
        if resetScroll then results.CanvasPosition = Vector2.new(0, 0) end
    end
    function api.SetCrop(crop)
        if destroyed or type(crop) ~= "table" then return end
        local seedId, blockId = number(crop.seedId), number(crop.blockId)
        if seedId < 1 or blockId < 1 then return end
        selectedSeedId = seedId
        local seedName, blockName = tostring(crop.seedName or ("Seed " .. seedId)), tostring(crop.blockName or ("Block " .. blockId))
        cropSelector.Text = "  " .. blockName .. " ↔ " .. seedName .. "   ▾"
        inventoryTitles.seeds.Text, inventoryTitles.blocks.Text = seedName, blockName
        if crop.seeds ~= nil then inventoryLabels.seeds.Text = tostring(number(crop.seeds)) end
        if crop.blocks ~= nil then inventoryLabels.blocks.Text = tostring(number(crop.blocks)) end
        renderResults(false)
    end
    function api.SetCrops(crops, currentSeedId)
        if destroyed then return end
        catalog, bySeed = {}, {}
        for _, value in ipairs(type(crops) == "table" and crops or {}) do
            if type(value) == "table" then
                local seedId, blockId = number(value.seedId), number(value.blockId)
                if seedId > 0 and blockId > 0 and not bySeed[seedId] then
                    local crop = { seedId = seedId, blockId = blockId, seedName = tostring(value.seedName or ("Seed " .. seedId)),
                        blockName = tostring(value.blockName or ("Block " .. blockId)), seeds = number(value.seeds), blocks = number(value.blocks), grow = number(value.grow) }
                    crop.searchKey = (crop.seedName .. " " .. crop.blockName .. " " .. seedId .. " " .. blockId):lower()
                    catalog[#catalog + 1], bySeed[seedId] = crop, crop
                end
            end
        end
        -- Keep the supplied order: the controller puts owned crops first.
        local selected = bySeed[number(currentSeedId)] or bySeed[selectedSeedId]
        if selected then api.SetCrop(selected) else renderResults(false) end
    end
    function api.SetRunning(value)
        if destroyed then return end
        running = value == true
        if running and pickerOpen then setPickerOpen(false) end
        start.Text = running and "RUNNING" or "START"
        start.BackgroundColor3 = running and Color3.fromRGB(29, 94, 76) or (anchored and colors.blue or colors.card)
        start.TextColor3 = running and colors.green or (anchored and colors.text or colors.muted)
        start.AutoButtonColor = not running and anchored
        capture.AutoButtonColor = not running
        capture.TextColor3 = running and colors.muted or colors.text
        cropSelector.AutoButtonColor = not running
        cropSelector.TextColor3 = running and colors.muted or colors.text
        modeFarm.AutoButtonColor, modeBreak.AutoButtonColor = not running, not running
        modeFarm.TextColor3, modeBreak.TextColor3 = running and colors.muted or colors.text, running and colors.muted or colors.text
        local canEditCount = not running and farmMode == "farm"
        countInput.TextEditable, countInput.Active = canEditCount, canEditCount
        countInput.TextColor3 = canEditCount and colors.text or colors.muted
        applyCount.Active, applyCount.AutoButtonColor = canEditCount, canEditCount
        applyCount.TextColor3 = canEditCount and colors.text or colors.muted
        applyCount.BackgroundColor3 = canEditCount and colors.blue or colors.card
        if not canEditCount and Input:GetFocusedTextBox() == countInput then countInput:ReleaseFocus() end
    end
    function api.SetPlantCount(value)
        if destroyed then return false end
        local count = tonumber(value)
        if not count or count ~= count or count < 1 or count > 99 or count % 1 ~= 0 then return false end
        local changed = count ~= plantCount
        plantCount = count
        if changed or Input:GetFocusedTextBox() ~= countInput then countInput.Text = tostring(plantCount) end
        renderPlants()
        if farmMode == "farm" then flowLabel.Text = "Tanam " .. plantCount .. " → farm 3 blok hingga matang → panen tuntas." end
        if api.SetStats then api.SetStats(lastStats) end
        return true
    end
    function api.SetMode(value)
        if destroyed or (value ~= "farm" and value ~= "break_only") then return end
        local changed = farmMode ~= value
        farmMode = value
        local onlyBreak = farmMode == "break_only"
        if changed then countInput:ReleaseFocus() countInput.Text = tostring(plantCount) end
        countRow.Visible = not onlyBreak
        modeFarm.Text, modeBreak.Text = onlyBreak and "FARM + TANAM" or "✓ FARM + TANAM", onlyBreak and "✓ BREAK ONLY" or "BREAK ONLY"
        modeFarm.BackgroundColor3, modeBreak.BackgroundColor3 = onlyBreak and colors.card or colors.blue, onlyBreak and colors.blue or colors.card
        renderPlants()
        treeCaption.Text, breakCaption.Visible = onlyBreak and "MODE" or "TANAM", onlyBreak
        flowLabel.Text = onlyBreak and "Pasang 3 blok → pukul 1→2→3 → ambil drop → ulang."
            or ("Tanam " .. plantCount .. " → farm 3 blok hingga matang → panen tuntas.")
        helpLabel.Text = onlyBreak and "Tanpa tanam seed; butuh stok block di tas.\nAmbil khusus hasil tiga block yang dipecahkan bot."
            or "Ambil khusus hasil break block bot.\nDrop pohon dibiarkan; terambil saat karakter lewat."
        if api.SetStats then api.SetStats(lastStats) end
        api.SetRunning(running)
    end
    function api.SetAnchor(value)
        if destroyed then return end
        anchored = type(value) == "table" and type(value.x) == "number" and type(value.y) == "number"
        anchor.Text = anchored and (tostring(value.world or "AAXYOU") .. " · Titik X " .. tostring(value.x) .. " / Y " .. tostring(value.y))
            or "Titik belum disimpan · tekan SET TITIK."
        anchor.TextColor3 = anchored and colors.green or colors.muted
        api.SetRunning(running)
    end
    function api.SetStats(value)
        if destroyed or type(value) ~= "table" then return end
        lastStats = value
        inventoryLabels.seeds.Text = tostring(number(value.seeds))
        inventoryLabels.blocks.Text = tostring(number(value.blocks))
        local seedCount = plantCount
        local growing, mature = number(value.growing), number(value.mature)
        if farmMode == "break_only" then
            progress.Text = "BREAK ONLY · Seed tidak ditanam atau dipanen."
            progress.TextColor3 = colors.muted
            totals.Text = "Pasang: " .. number(value.placed) .. "  ·  Pukul: " .. number(value.punches) .. "  ·  Diambil: " .. number(value.collected)
        else
            progress.Text = "Terisi " .. math.min(seedCount, growing + mature) .. "/" .. seedCount
                .. " · Tumbuh: " .. growing .. " · Matang: " .. mature
            progress.TextColor3 = mature > 0 and colors.green or colors.muted
            totals.Text = "Tanam: " .. number(value.planted) .. "  ·  Pasang: " .. number(value.placed)
                .. "  ·  Pukul: " .. number(value.punches) .. "  ·  Panen: " .. number(value.harvested)
        end
    end
    local function invoke(name, ...)
        if destroyed then return end
        local callback = options[name]
        if type(callback) == "function" then
            local ok, result, detail = pcall(callback, ...)
            if not ok then api.SetStatus("Aksi gagal: " .. tostring(result):sub(1, 130)) return false end
            return result, detail
        end
    end
    local function notifyClosed()
        if notified then return end
        notified = true
        invoke("onClose")
    end
    function api.Destroy()
        if destroyed then return end
        destroyed, running, dragging = true, false, nil
        search:ReleaseFocus()
        countInput:ReleaseFocus()
        if cameraConnection then cameraConnection:Disconnect() cameraConnection = nil end
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
        gui:Destroy()
    end
    connect(start.Activated, function() if not running and anchored then invoke("onStart") end end)
