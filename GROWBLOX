recoverStep=function(now,view)
    if not app.WantsRun or not app.LastRun then return false end
    if view.picker or not view.ready or view.world=="" then
        beginRecovery(now)
        recoveryBound=false arrivalAt=nil
        if adapter then adapter.Release() end
        if not view.ready or view.loading or view.typing then
            recoveryStatus(view.typing and "Pemulihan dijeda saat mengetik." or "Menunggu world siap untuk masuk kembali.")
        elseif joinPending then recoveryStatus("Sedang masuk kembali ke "..app.LastRun.world.."...")
        elseif now<nextJoin then recoveryStatus("Masuk kembali ke "..app.LastRun.world.." dalam "..math.ceil(nextJoin-now).." detik.")
        else
            local token,target=recoveryToken,app.LastRun.world
            joinPending=true joinAttempts=joinAttempts+1
            recoveryStatus("Masuk kembali ke "..target.."...")
            task.spawn(function()
                if not app.Alive or not app.WantsRun or token~=recoveryToken then return end
                local ok,entered,message=pcall(session.Enter,target)
                if not app.Alive or not app.WantsRun or token~=recoveryToken then return end
                joinPending=false
                nextJoin=os.clock()+math.min(30,5*2^math.min(joinAttempts-1,3))
                if not ok or entered==false then
                    recoveryStatus("Belum bisa masuk "..target..": "..tostring(ok and message or entered):sub(1,110).."; mencoba lagi.")
                end
            end)
        end
        return true
    end
    if not app.Recovering then return false end
    local plan=app.LastRun
    if view.world~=plan.world then
        app.Stop()
        bindCurrentWorld(true)
        recoveryStatus("World berbeda dipilih. SET TITIK untuk memulai di world ini.")
        return true
    end
    if not recoveryBound then
        if now<nextBind then return true end
        nextBind=now+1
        local unauthorized=false
        local ok,why=pcall(function()
            if engine then engine.Close() end
            if adapter then adapter.Release() end
            app.Mode,app.PlantCount=plan.mode,plan.plantCount
            adapter=makeAdapter(game.Players.LocalPlayer,app) app.Adapter=adapter
            assert(adapter.Context.name==plan.world,"Data world belum sesuai.")
            app.World,app.Job=plan.world,game.JobId
            assert(type(adapter.Context.lock)=="table" and adapter.Context.lock.owner~=nil,"Menunggu data world lock.")
            if not adapter.IsWorldAuthorized() then unauthorized=true error("Akses world berubah.") end
            local selected,message=adapter.SetCrop(plan.seedId) assert(selected,message)
            app.Crop=adapter.GetCrop()
            app.Anchor=copy(plan.anchor) app.Anchor.job=game.JobId
            app.NeedsCapture=false
            resetEngine(plan.progress)
            pickup=makePickupDriver({View=adapter.PickupView,Move=adapter.Move,Jump=adapter.Jump,Release=adapter.Release},{radius=10})
            app.Pickup=pickup
            ui.SetAnchor(app.Anchor) ui.SetMode(app.Mode) ui.SetPlantCount(app.PlantCount) ui.SetCrop(app.Crop)
            recoveryBound=true
        end)
        if not ok then
            if adapter then adapter.Release() end
            if unauthorized then app.Stop() recoveryStatus("Akses world berubah; pemulihan dihentikan.") return true end
            recoveryStatus("Menunggu data / izin world: "..tostring(why):sub(1,130))
            return true
        end
    end
    local ok,arrived,message,fatal=pcall(adapter.ReturnToAnchor,now)
    if not ok then
        adapter.Release() arrivalAt=nil
        recoveryStatus("Menunggu jalur kembali: "..tostring(arrived):sub(1,130))
    elseif fatal then
        app.Stop() recoveryStatus(tostring(message or "Titik / izin farm berubah; SET TITIK ulang."))
    elseif arrived then
        arrivalAt=arrivalAt or now
        recoveryStatus("Sudah di titik farm. Menunggu posisi stabil...")
        if now-arrivalAt>=.4 then
            adapter.Release()
            engine.Start()
            app.Recovering=false
            app.WantsRun=engine.State.running==true
            recoveryStatus(engine.State.status)
        end
    else
        arrivalAt=nil
        recoveryStatus(message or "Berjalan kembali ke titik farm tersimpan...")
    end
    return true
end
